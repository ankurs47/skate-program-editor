{
  "name": "skate-program-editor",
  "version": "1.0.0",
  "description": "Browser tool for cutting figure skating program music",
  "private": true,
  "scripts": {
    "test": "node test/run.js",
    "test:net": "node test/run.js --net",
    "test:dom": "node test/dom/run.js",
    "test:mutate": "./tools/mutate-worktree.sh",
    "test:mutate:here": "node test/mutate.js",
    "check:sources": "node tools/check-sources.js",
    "build:encoder": "node tools/build-mp3-encoder.js",
    "check:encoder": "node tools/build-mp3-encoder.js --check",
    "screenshot": "node tools/screenshot.js",
    "lint": "eslint .",
    "check": "npm run lint && npm test",
    "prepare": "node tools/install-hooks.js"
  },
  "devDependencies": {
    "eslint": "^9.15.0"
  },
  "license": "MIT"
}
