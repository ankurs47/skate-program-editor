#!/bin/sh
# Runs lint and the test suite before every commit.
# Enabled by `npm install` (see the prepare script), or manually with:
#   git config core.hooksPath .githooks
#
# To bypass in a genuine emergency: git commit --no-verify

set -e

if [ ! -d node_modules ]; then
  echo "pre-commit: node_modules missing, run 'npm install' first" >&2
  exit 1
fi

echo "pre-commit: linting..."
npm run --silent lint

echo "pre-commit: testing..."
npm run --silent test

echo "pre-commit: ok"
