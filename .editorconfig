# Editor defaults, so a contributor's setup matches what is already here rather
# than reformatting a file the moment they open it. The pre-commit hooks enforce
# the last three; the indent widths are convention, not checked.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Markdown gives two trailing spaces a meaning, so they are left alone here.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.cmd]
# Windows shell, and cmd is unforgiving about line endings.
end_of_line = crlf
